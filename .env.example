# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://intelligence-platform-cmot.vercel.app

# ── Admin upload auth ─────────────────────────────────────────────────────────
# Change this before deploying — used as Bearer token for /admin/upload
ADMIN_TOKEN=change_me_before_deploy

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
STORE_DIR=./data/store
MAX_UPLOAD_MB=50

# ── Database (local SQLite for self-hosted; Supabase replaces this in prod) ───
DATABASE_URL=sqlite+aiosqlite:///./data/store/platform.db

# ── Master Admin ──────────────────────────────────────────────────────────────
# Superuser credentials — stored in env only, never in the database
# Generate MASTER_TOKEN with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_EMAIL=admin@yourplatform.com
MASTER_PASSWORD=change_me_strong_password
MASTER_TOKEN=change_me_random_32_char_hex_string

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only, never exposed to browser

# ── Vercel env var names (set these in Vercel Dashboard → Project → Settings → Environment Variables) ──
# SUPABASE_URL          → same as above
# SUPABASE_ANON_KEY     → same as above
# ADMIN_TOKEN           → a strong random string
# ALLOWED_ORIGINS       → your frontend Vercel URLs
